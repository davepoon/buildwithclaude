{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-combo-bench.local/schemas/skill_manifest.schema.json",
  "title": "V6.0 Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "name", "version", "description", "rules", "required_tools", "forbidden_actions", "input_modalities", "output_expectations", "priority_claims", "test_coverage", "source_file", "source_sha256"],
  "properties": {
    "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "text"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["mock_calculator", "mock_database", "mock_weather", "mock_file_store", "mock_search"]}},
    "forbidden_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["text", "image", "audio", "video", "structured_data"]}},
    "output_expectations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priority_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "test_coverage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_file": {"type": "string", "pattern": "^tests/mock_skills/[a-z0-9-]+\\.md$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
